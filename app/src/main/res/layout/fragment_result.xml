<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <View android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/headName" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/headCust" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <View android:id="@+id/headBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <View android:id="@+id/stepper" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/timeStart" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/timeDone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/timeDuration" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:id="@+id/taskRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/customerRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/oldSub" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <id.pamtirtakemuning.watermeter.ui.view.PhotoCapture android:id="@+id/thumbOld" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:id="@+id/meterRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <id.pamtirtakemuning.watermeter.ui.view.PhotoCapture android:id="@+id/thumbNew" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <LinearLayout android:id="@+id/condRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <ImageView android:id="@+id/signature" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/signatureText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/officer" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <View android:id="@+id/actionBar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
