<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">
    <View android:id="@+id/circle" android:layout_width="24dp" android:layout_height="24dp"/>
    <ImageView android:id="@+id/icon" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null"/>
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <View android:id="@+id/halo" android:layout_width="24dp" android:layout_height="24dp"/>
</LinearLayout>
