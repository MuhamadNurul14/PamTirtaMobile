<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <id.pamtirtakemuning.watermeter.ui.view.PhotoCapture android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <id.pamtirtakemuning.watermeter.ui.view.StatusBadge android:id="@+id/from" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <id.pamtirtakemuning.watermeter.ui.view.StatusBadge android:id="@+id/to" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/ok" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
