<?xml version="1.0" encoding="utf-8"?>
<!-- Layout utama: wadah Fragment halaman + bottom nav + toast -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Navigasi bawah: Tugas / Riwayat / Profile -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/navy_15"
        android:outlineSpotShadowColor="@color/navy_15"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/navTugas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navTugasPill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill">

                <ImageView
                    android:id="@+id/navTugasIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_clipboard_list" />
            </FrameLayout>

            <TextView
                android:id="@+id/navTugasLabel"
                style="@style/Tx.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tugas"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRiwayat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navRiwayatPill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill">

                <ImageView
                    android:id="@+id/navRiwayatIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_history" />
            </FrameLayout>

            <TextView
                android:id="@+id/navRiwayatLabel"
                style="@style/Tx.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Riwayat"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navProfilPill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill">

                <ImageView
                    android:id="@+id/navProfilIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user_round" />
            </FrameLayout>

            <TextView
                android:id="@+id/navProfilLabel"
                style="@style/Tx.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Profile"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        style="@style/Tx.Semi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_toast"
        android:elevation="16dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
