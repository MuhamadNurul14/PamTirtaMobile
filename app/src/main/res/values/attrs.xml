<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="PButton">
        <attr name="btnText" format="string" />
        <attr name="btnIcon" format="reference" />
        <attr name="btnVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="outline" value="2" />
            <enum name="success" value="3" />
            <enum name="danger" value="4" />
            <enum name="dangerOutline" value="5" />
        </attr>
        <attr name="btnSize" format="enum">
            <enum name="small" value="0" />
            <enum name="medium" value="1" />
            <enum name="large" value="2" />
        </attr>
    </declare-styleable>
    <declare-styleable name="IconChip">
        <attr name="chipIcon" format="reference" />
        <attr name="chipColor" format="color" />
        <attr name="chipTint" format="color" />
        <attr name="chipSize" format="dimension" />
        <attr name="iconSize" format="dimension" />
        <attr name="chipRadius" format="dimension" />
    </declare-styleable>
    <declare-styleable name="PageHeader">
        <attr name="headerTitle" format="string" />
        <attr name="showBack" format="boolean" />
        <attr name="headerColor" format="color" />
    </declare-styleable>
    <declare-styleable name="SelectField">
        <attr name="fieldLabel" format="string" />
        <attr name="fieldPlaceholder" format="string" />
    </declare-styleable>
</resources>
